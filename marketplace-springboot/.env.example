# Copy this file to .env and fill in real values before running docker compose up.
# .env is gitignored — never commit real secrets.

DB_NAME=marketplace
DB_USER=marketplace_user
DB_PASSWORD=changeme

JWT_SECRET=replace_this_with_a_long_random_value_before_deploying

RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

CASHFREE_CLIENT_ID=placeholder_client_id
CASHFREE_CLIENT_SECRET=placeholder_client_secret
CASHFREE_WEBHOOK_SECRET=placeholder_webhook_secret

PAYU_MERCHANT_KEY=placeholder_key
PAYU_SALT=placeholder_salt

SHIPROCKET_EMAIL=placeholder@example.com
SHIPROCKET_PASSWORD=placeholder_password
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_WEBHOOK_TOKEN=replace_this_shared_secret_before_deploying

SMTP_HOST=smtp.gmail.com
SMTP_USERNAME=placeholder@example.com
SMTP_PASSWORD=placeholder_password
MAIL_FROM=no-reply@marketplace.local

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_BASE_URL=http://localhost:5173
